---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';

const practice = (await getCollection('practice')).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Practice areas" description="Kendot Legal's practice areas: corporate and commercial, real estate and tenancy, tax, intellectual property and data protection, and dispute resolution.">
  <PageHeader eyebrow="What we do" title="Practice areas" summary="Five focused practices, each led by a partner or senior lawyer." />
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 divide-y divide-line border-y border-line">
    {practice.map((p, i) => (
      <a href={`/practice/${p.id}/`} class="group grid gap-2 sm:grid-cols-[80px_1fr_auto] items-baseline py-8">
        <span class="font-serif text-brass-deep">0{i + 1}</span>
        <span>
          <span class="block text-2xl font-serif font-semibold group-hover:underline underline-offset-4 decoration-brass">{p.data.title}</span>
          <span class="block mt-2 text-muted leading-relaxed max-w-2xl">{p.data.summary}</span>
        </span>
        <span class="text-sm font-medium text-ink-soft group-hover:text-brass-deep" aria-hidden="true">Read more</span>
      </a>
    ))}
  </div>
</Layout>
