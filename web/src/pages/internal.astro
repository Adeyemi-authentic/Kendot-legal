---
// The internal assistant: for the firm's lawyers and staff, behind a password.
// The page itself holds nothing secret. The API checks the password, issues a
// session token, and answers only from the firm's internal documents, which
// the public assistant cannot reach (api/tests/test_separation.py).
import Layout from '../layouts/Layout.astro';
import { SITE } from '../site';

const apiBase = import.meta.env.PUBLIC_ASSISTANT_API ?? 'http://localhost:8000';
const starters = [
  'What liability cap do we start with when acting for a buyer on a share sale?',
  'What must an engagement letter cover?',
  'A client has had a data breach. What do we do in the first 24 hours?',
  'What happens if the conflict check finds a current client on the other side?',
];
---

<Layout title="Internal assistant" internal>
  <section class="border-b border-line bg-ink text-paper">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 py-10 sm:py-12">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brass">Staff only</p>
      <h1 class="mt-3 text-3xl sm:text-4xl font-semibold leading-tight">Internal knowledge assistant</h1>
      <p class="mt-4 text-paper/80 leading-relaxed max-w-2xl">
        Answers from {SITE.name}'s own precedents, templates and procedures, with the document each answer comes from.
        These documents are kept apart from the public website assistant.
      </p>
    </div>
  </section>

  <div id="kl-int" data-api={apiBase} class="mx-auto max-w-3xl px-4 sm:px-6 py-10">
    <!-- Sign in -->
    <form id="int-login" class="max-w-sm space-y-4" hidden>
      <div>
        <label for="int-password" class="block text-sm font-medium mb-1.5">Staff password</label>
        <input id="int-password" type="password" required maxlength="200" autocomplete="current-password"
          class="w-full rounded-sm border border-line bg-white px-3 py-2.5 text-base focus:outline-none focus:border-brass" />
      </div>
      <p id="int-login-error" class="hidden text-sm text-red-700" role="alert"></p>
      <button type="submit" class="rounded-sm bg-ink text-paper px-5 py-2.5 font-medium hover:bg-ink-soft disabled:opacity-50 transition-colors">Sign in</button>
      <p class="text-xs text-muted leading-relaxed">Sessions end after 8 hours, or when you close this tab.</p>
    </form>

    <!-- Chat -->
    <section id="int-chat" hidden aria-labelledby="int-chat-title">
      <div class="flex items-center justify-between gap-4 border-b border-line pb-3">
        <h2 id="int-chat-title" class="font-serif text-xl font-semibold">Ask about the firm's documents</h2>
        <div class="flex items-center gap-4 text-sm">
          <button id="int-reset" type="button" class="text-muted hover:text-ink underline-offset-4 hover:underline">New conversation</button>
          <button id="int-logout" type="button" class="text-muted hover:text-ink underline-offset-4 hover:underline">Sign out</button>
        </div>
      </div>

      <div id="int-log" class="py-6 space-y-5 text-[15px]" aria-live="polite" aria-relevant="additions">
        <div id="int-welcome" class="space-y-3">
          <p class="text-ink-soft leading-relaxed">Try one of these, or ask your own question.</p>
          <div class="flex flex-col items-start gap-2">
            {starters.map((q) => (
              <button type="button" data-starter class="text-left text-sm rounded-full border border-line bg-white px-3.5 py-1.5 hover:border-brass transition-colors">{q}</button>
            ))}
          </div>
        </div>
      </div>

      <form id="int-form" class="sticky bottom-0 border-t border-line bg-paper py-3" autocomplete="off">
        <label for="int-input" class="sr-only">Your question</label>
        <div class="flex items-end gap-2">
          <textarea id="int-input" rows="2" maxlength="500" placeholder="Ask about a precedent, template or procedure"
            class="flex-1 resize-none rounded-sm border border-line bg-white px-3 py-2.5 text-base leading-snug max-h-40 focus:outline-none focus:border-brass"></textarea>
          <button id="int-send" type="submit" class="shrink-0 rounded-sm bg-ink text-paper px-5 py-2.5 text-sm font-medium hover:bg-ink-soft disabled:opacity-50 transition-colors">Ask</button>
        </div>
      </form>
    </section>
  </div>
</Layout>

<script>
  import { ChatHttpError, format, streamChat, type Source } from '../lib/chat';

  type Msg = { role: 'user' | 'assistant'; text: string; sources?: Source[]; error?: boolean };

  const root = document.getElementById('kl-int')!;
  const API = (root.dataset.api || '').replace(/\/$/, '');
  const loginForm = document.getElementById('int-login') as HTMLFormElement;
  const password = document.getElementById('int-password') as HTMLInputElement;
  const loginError = document.getElementById('int-login-error') as HTMLElement;
  const chat = document.getElementById('int-chat') as HTMLElement;
  const log = document.getElementById('int-log') as HTMLElement;
  const welcome = document.getElementById('int-welcome') as HTMLElement;
  const form = document.getElementById('int-form') as HTMLFormElement;
  const input = document.getElementById('int-input') as HTMLTextAreaElement;
  const send = document.getElementById('int-send') as HTMLButtonElement;

  // sessionStorage: the token dies with the tab. Never localStorage on a shared office PC.
  const TOKEN = 'kl-internal-token';
  const MAX_HISTORY = 6;
  let messages: Msg[] = [];
  let busy = false;

  function token() {
    try { return sessionStorage.getItem(TOKEN) || ''; } catch { return ''; }
  }
  function auth(): Record<string, string> {
    return { Authorization: `Bearer ${token()}` };
  }

  function showLogin(message = '') {
    try { sessionStorage.removeItem(TOKEN); } catch { /* storage blocked */ }
    chat.hidden = true;
    loginForm.hidden = false;
    loginError.textContent = message;
    loginError.classList.toggle('hidden', !message);
    password.value = '';
    password.focus();
  }
  function showChat() {
    loginForm.hidden = true;
    chat.hidden = false;
    input.focus();
  }

  // --- sign in -------------------------------------------------------------
  loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submit = loginForm.querySelector('button[type=submit]') as HTMLButtonElement;
    submit.disabled = true;
    try {
      const res = await fetch(`${API}/internal/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: password.value }),
      });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(res.status === 404 ? 'The internal assistant is not switched on.' : body.error || 'Sign-in failed.');
      try { sessionStorage.setItem(TOKEN, body.token); } catch { /* falls back to this page view only */ }
      showChat();
    } catch (err) {
      showLogin(err instanceof TypeError ? "Couldn't reach the server. It may be waking up: try again in a minute." : (err as Error).message);
    } finally {
      submit.disabled = false;
    }
  });
  document.getElementById('int-logout')!.addEventListener('click', () => {
    messages = [];
    renderAll();
    showLogin();
  });
  document.getElementById('int-reset')!.addEventListener('click', () => {
    if (busy) return;
    messages = [];
    renderAll();
    input.focus();
  });

  // --- rendering -----------------------------------------------------------
  function bubble(msg: Msg): HTMLElement {
    const wrap = document.createElement('div');
    if (msg.role === 'user') {
      wrap.className = 'flex justify-end';
      wrap.innerHTML = '<p class="max-w-[85%] rounded-md bg-ink text-paper px-4 py-2.5 leading-relaxed whitespace-pre-wrap"></p>';
      wrap.firstElementChild!.textContent = msg.text;
      return wrap;
    }
    wrap.className = 'space-y-2';
    const tone = msg.error ? 'bg-brass-soft border-brass/40 text-ink' : 'bg-white border-line text-ink-soft';
    wrap.innerHTML = `<div class="int-text rounded-md border ${tone} px-4 py-3 leading-relaxed space-y-2"></div>`;
    setText(wrap, msg);
    return wrap;
  }
  function setText(wrap: HTMLElement, msg: Msg) {
    (wrap.querySelector('.int-text') as HTMLElement).innerHTML = msg.text
      ? format(msg.text)
      : '<span class="text-muted text-sm">Searching the firm\'s documents...</span>';
    wrap.querySelector('.int-sources')?.remove();
    if (msg.sources?.length) {
      const box = document.createElement('div');
      box.className = 'int-sources flex flex-wrap items-center gap-1.5 text-xs';
      box.innerHTML = '<span class="text-muted">From:</span>';
      for (const s of msg.sources) {
        const chip = document.createElement('span');
        chip.className = 'rounded-full border border-line bg-white px-2.5 py-1 text-ink';
        chip.textContent = s.title;
        box.append(chip);
      }
      wrap.append(box);
    }
  }
  function renderAll() {
    log.querySelectorAll(':scope > :not(#int-welcome)').forEach((n) => n.remove());
    welcome.hidden = messages.length > 0;
    for (const m of messages) log.append(bubble(m));
  }

  // --- asking ----------------------------------------------------------------
  async function ask(question: string) {
    question = question.trim();
    if (!question || busy) return;
    busy = true;
    send.disabled = true;
    const prior = messages.filter((m) => !m.error).slice(-MAX_HISTORY)
      .map((m) => ({ role: m.role, text: m.text.slice(0, 1000) }));
    messages.push({ role: 'user', text: question });
    welcome.hidden = true;
    log.append(bubble(messages[messages.length - 1]));
    const reply: Msg = { role: 'assistant', text: '' };
    const wrap = bubble(reply);
    log.append(wrap);
    wrap.scrollIntoView({ block: 'nearest' });

    try {
      for await (const ev of streamChat(`${API}/internal/chat/stream`, { question, history: prior }, auth())) {
        if (ev.type === 'token') {
          reply.text += ev.text;
          setText(wrap, reply);
        } else if (ev.type === 'done') {
          reply.sources = ev.sources || [];
          setText(wrap, reply);
        } else if (ev.type === 'error') {
          throw new Error(ev.error);
        }
      }
      if (!reply.text) throw new Error('Sorry, something went wrong. Please try again.');
    } catch (err) {
      if (err instanceof ChatHttpError && err.status === 401) {
        messages = [];
        renderAll();
        showLogin('Your session has ended. Please sign in again.');
        return;
      }
      reply.error = true;
      reply.sources = [];
      reply.text = err instanceof TypeError
        ? "Couldn't reach the assistant. Please try again in a moment."
        : (err as Error).message;
      setText(wrap, reply);
      wrap.replaceWith(bubble(reply));
    } finally {
      if (!chat.hidden) messages.push(reply);
      busy = false;
      send.disabled = false;
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = input.value;
    input.value = '';
    ask(q);
  });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); form.requestSubmit(); }
  });
  log.querySelectorAll<HTMLButtonElement>('[data-starter]').forEach((b) =>
    b.addEventListener('click', () => ask(b.textContent || '')));

  // --- on load: resume a live session, else ask for the password ------------
  fetch(`${API}/health`).catch(() => {});   // wake the free-tier server while they type
  (async () => {
    if (!token()) return showLogin();
    try {
      const res = await fetch(`${API}/internal/session`, { headers: auth() });
      if (res.ok) showChat(); else showLogin(res.status === 401 ? 'Your session has ended. Please sign in again.' : '');
    } catch {
      showLogin("Couldn't reach the server. It may be waking up: try again in a minute.");
    }
  })();
</script>
