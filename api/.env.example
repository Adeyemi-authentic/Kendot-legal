# Copy to .env and fill in. NEVER commit the real .env.

# --- Model providers ---
ANTHROPIC_API_KEY=sk-ant-...        # console.anthropic.com  (generation)
VOYAGE_API_KEY=pa-...               # voyageai.com  (embeddings + reranker)

# --- Admin key (X-API-Key on /admin/* only; the public chat needs no key) ---
API_KEY=hk_generate_a_long_random_string

# --- Retrieval + leads store ---
# qdrant = local index files + SQLite leads (dev);  pg = pgvector + Postgres leads (prod)
ENGINE=qdrant
# Required only when ENGINE=pg. Format:
# postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=
# Per-firm names, so several demos can share one database.
COLLECTION=kendot_site              # local Qdrant collection
CHUNKS_TABLE=kendot_chunks          # pgvector table
LEADS_TABLE=kendot_leads

# --- Public widget protection ---
# Origins allowed to call the API from a browser: the firm's site only.
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
CHAT_RATE_LIMIT=10                  # chat requests per IP ...
CHAT_RATE_WINDOW=60                 # ... per this many seconds
INTAKE_RATE_LIMIT=5                 # enquiry forms per IP ...
INTAKE_RATE_WINDOW=3600             # ... per hour
DAILY_BUDGET_USD=1.00               # estimated AI spend per UTC day before chat pauses
VOYAGE_MAX_WAIT=8                   # seconds a chat waits out Voyage rate limits before "busy"
TRUST_PROXY=0                       # 1 on Render (reads the client IP from X-Forwarded-For)

# --- Internal assistant (/internal page: the firm's own precedents) ---
# Empty password = switched off (the /internal/* routes return 404).
INTERNAL_PASSWORD=
INTERNAL_SECRET=                    # signs staff sessions; empty = derived from API_KEY
INTERNAL_SESSION_HOURS=8
INTERNAL_DAILY_BUDGET_USD=1.00      # separate from the public cap
INTERNAL_COLLECTION=kendot_internal         # local Qdrant (its own folder: rag/index_internal/)
INTERNAL_TABLE=kendot_internal_chunks       # pgvector; must differ from CHUNKS_TABLE
LOGIN_RATE_LIMIT=5                  # sign-in attempts per IP ...
LOGIN_RATE_WINDOW=900               # ... per 15 minutes

# --- Firm ---
FIRM_WHATSAPP=+234 700 000 0003     # used for the wa.me link after an enquiry

# --- Consultation bookings (/book page) ---
SITE_URL=http://localhost:4321      # the website; Paystack returns visitors here, alerts link here
BOOKING_FEE_NGN=50000
BOOKING_LENGTH_MIN=45               # consultation length ...
BOOKING_STEP_MIN=60                 # ... and the gap between start times (45 + 15 min buffer)
BOOKING_DAY_START=08:30             # office hours, WAT
BOOKING_DAY_END=17:30
BOOKING_WEEKDAYS=0,1,2,3,4          # Monday = 0
BOOKING_DAYS_AHEAD=14
BOOKING_MIN_NOTICE_HOURS=24
BOOKING_HOLD_MINUTES=30             # how long a slot is held while the visitor pays
TRANSFER_HOLD_HOURS=24              # held this long after "I've sent a transfer"
BOOKINGS_TABLE=kendot_bookings
FIRM_OFFICES=Lagos=12 Kendot Close, Lekki Phase 1, Lagos|Abuja=Suite 4, Kendot House, Wuse 2, Abuja
# Direct transfer details shown to the visitor (the narration is the booking reference)
FIRM_BANK_NAME=Demo Bank
FIRM_BANK_ACCOUNT_NAME=Kendot Legal (demo)
FIRM_BANK_ACCOUNT_NUMBER=0000000000

# Paystack (empty = direct transfer only). Use the sk_test_ key for the demo.
# Webhook URL to set in the Paystack dashboard: <API URL>/payments/paystack/webhook
PAYSTACK_SECRET_KEY=

# Google Calendar (none set = every office-hours slot is free and nothing is written).
GOOGLE_CALENDAR_ID=                 # empty = the impersonated user's (or OAuth user's) primary calendar
# Option A, Google Workspace (client builds): service account with domain-wide delegation
GOOGLE_SERVICE_ACCOUNT_JSON=        # the key JSON itself, or a path to it
GOOGLE_CALENDAR_IMPERSONATE=        # the firm user it acts as, e.g. bookings@firm.com
# Option B, personal Google account (demo): python scripts/google_oauth.py prints these
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# WhatsApp alerts to the firm (Meta WhatsApp Cloud API; empty = alerts go to the log)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
FIRM_ALERT_NUMBERS=                 # comma-separated, e.g. +2348012345678,+2348098765432
WHATSAPP_TEMPLATE=                  # approved template with one body variable; empty = plain text
WHATSAPP_TEMPLATE_LANG=en
