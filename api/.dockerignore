# Keep secrets, local-only state, and dev cruft out of the image.
.env
.venv/
.git/
__pycache__/
*.pyc

# Local Qdrant index -- production builds the pgvector store instead.
rag/index_data/
rag/index_internal/

# Local eval cache and docs bundle not needed at runtime.
rag/eval_cache.json
docs/

# Local enquiries (dev). Production stores leads in Postgres.
rag/leads.sqlite

# Internal documents: production reads them from the pgvector table, so the
# image carries only their titles (internal_docs/sources.json), never the text.
rag/internal_docs/*.md
rag/internal_docs/*.txt
