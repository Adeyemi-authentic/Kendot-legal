# Copy to .env and fill in. NEVER commit the real .env.

# --- Model providers ---
ANTHROPIC_API_KEY=sk-ant-...        # console.anthropic.com  (generation)
VOYAGE_API_KEY=pa-...               # voyageai.com  (embeddings + reranker)

# --- Admin key (X-API-Key on /admin/* only; the public chat needs no key) ---
API_KEY=hk_generate_a_long_random_string

# --- Retrieval + leads store ---
# qdrant = local index files + SQLite leads (dev);  pg = pgvector + Postgres leads (prod)
ENGINE=qdrant
# Required only when ENGINE=pg. Format:
# postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=
# Per-firm names, so several demos can share one database.
COLLECTION=kendot_site              # local Qdrant collection
CHUNKS_TABLE=kendot_chunks          # pgvector table
LEADS_TABLE=kendot_leads

# --- Public widget protection ---
# Origins allowed to call the API from a browser: the firm's site only.
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
CHAT_RATE_LIMIT=10                  # chat requests per IP ...
CHAT_RATE_WINDOW=60                 # ... per this many seconds
INTAKE_RATE_LIMIT=5                 # enquiry forms per IP ...
INTAKE_RATE_WINDOW=3600             # ... per hour
DAILY_BUDGET_USD=1.00               # estimated AI spend per UTC day before chat pauses
VOYAGE_MAX_WAIT=8                   # seconds a chat waits out Voyage rate limits before "busy"
TRUST_PROXY=0                       # 1 on Render (reads the client IP from X-Forwarded-For)

# --- Internal assistant (/internal page: the firm's own precedents) ---
# Empty password = switched off (the /internal/* routes return 404).
INTERNAL_PASSWORD=
INTERNAL_SECRET=                    # signs staff sessions; empty = derived from API_KEY
INTERNAL_SESSION_HOURS=8
INTERNAL_DAILY_BUDGET_USD=1.00      # separate from the public cap
INTERNAL_COLLECTION=kendot_internal         # local Qdrant (its own folder: rag/index_internal/)
INTERNAL_TABLE=kendot_internal_chunks       # pgvector; must differ from CHUNKS_TABLE
LOGIN_RATE_LIMIT=5                  # sign-in attempts per IP ...
LOGIN_RATE_WINDOW=900               # ... per 15 minutes

# --- Firm ---
FIRM_WHATSAPP=+234 700 000 0003     # used for the wa.me link after an enquiry
