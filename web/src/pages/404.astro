---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <section class="mx-auto max-w-3xl px-4 sm:px-6 py-24 text-center">
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-brass-deep">404</p>
    <h1 class="mt-4 text-4xl font-semibold">We could not find that page</h1>
    <p class="mt-4 text-muted">The page may have moved. Try our practice areas or insights instead.</p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/practice/" class="rounded-sm bg-ink text-paper px-5 py-2.5 text-sm font-medium">Practice areas</a>
      <a href="/insights/" class="rounded-sm border border-line px-5 py-2.5 text-sm font-medium">Insights</a>
    </div>
  </section>
</Layout>
